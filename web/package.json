{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "api:generate": "node scripts/contract-api.mjs",
    "api:check": "node scripts/contract-api.mjs --check",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e:server": "bun run build && bun run preview -- --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:demo": "PLAYWRIGHT_SLOW_MO=1500 playwright test --headed --workers=1",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:e2e:real:demo": "PLAYWRIGHT_SLOW_MO=1200 playwright test --config playwright.real.config.ts --headed --workers=1",
    "test:e2e:journey": "playwright test --config playwright.journey.config.ts",
    "test:e2e:journey:demo": "PLAYWRIGHT_SLOW_MO=1200 playwright test --config playwright.journey.config.ts --headed --workers=1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^8",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}

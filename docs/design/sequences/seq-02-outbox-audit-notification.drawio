        <mxCell id="m8" value="SELECT … WHERE published_at IS NULL AND cancelled_at IS NULL&lt;br&gt;AND (claimed_at IS NULL OR claimed_at &amp;lt; now() − lease) ORDER BY created_at" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="712" as="sourcePoint" /><mxPoint x="280" y="712" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m10" value="UPDATE outbox SET claimed_at = now()&lt;br&gt;WHERE id = ? AND &lt;same predicate&gt;" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="804" as="sourcePoint" /><mxPoint x="280" y="804" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="1 row — claim won" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="850" as="sourcePoint" /><mxPoint x="485" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="publish routing_key = event_type&lt;br&gt;envelope{event_id = outbox.id, occurred_at, actor, payload}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="1018" as="sourcePoint" /><mxPoint x="700" y="1018" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="UPDATE outbox SET published_at = now()" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="1064" as="sourcePoint" /><mxPoint x="280" y="1064" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="UPDATE outbox SET cancelled_at = now()&lt;br&gt;WHERE id = ? AND claimed_at IS NULL&lt;br&gt;AND cancelled_at IS NULL AND published_at IS NULL" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1250" as="sourcePoint" /><mxPoint x="270" y="1250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="1 row ⇒ never dispatched, safe to abandon · 0 rows ⇒ claimed, do NOT cancel" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1296" as="sourcePoint" /><mxPoint x="65" y="1296" as="targetPoint" /></mxGeometry></mxCell>

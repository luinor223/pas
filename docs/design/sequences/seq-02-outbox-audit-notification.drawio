        <mxCell id="m1" value="BEGIN" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="238" as="sourcePoint" /><mxPoint x="270" y="238" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="UPDATE &amp;lt;entity&amp;gt; SET status = …, version = version + 1" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="284" as="sourcePoint" /><mxPoint x="270" y="284" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="INSERT status_history (from_status, to_status, trigger_kind, trigger_ref)&lt;br&gt;in the four schemas that own a state machine (D17)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="345" as="sourcePoint" /><mxPoint x="270" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="INSERT outbox (event_type='audit.recorded', payload)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="391" as="sourcePoint" /><mxPoint x="270" y="391" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="INSERT outbox (event_type=&amp;lt;domain event&amp;gt;, payload)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="437" as="sourcePoint" /><mxPoint x="270" y="437" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="COMMIT" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="483" as="sourcePoint" /><mxPoint x="270" y="483" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="ok" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="529" as="sourcePoint" /><mxPoint x="65" y="529" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="SELECT … WHERE published_at IS NULL AND cancelled_at IS NULL&lt;br&gt;AND (claimed_at IS NULL OR claimed_at &amp;lt; now() − lease) ORDER BY created_at" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="714" as="sourcePoint" /><mxPoint x="280" y="714" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="pending rows" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="760" as="sourcePoint" /><mxPoint x="485" y="760" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="UPDATE outbox SET claimed_at = now()&lt;br&gt;WHERE id = ? AND &amp;lt;same predicate&amp;gt;" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="821" as="sourcePoint" /><mxPoint x="280" y="821" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="1 row — claim won" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="867" as="sourcePoint" /><mxPoint x="485" y="867" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="send(topic = pas.events | pas.audit, key = aggregate_id = document id,&lt;br&gt;headers{event_type, document_type},&lt;br&gt;value = envelope{event_id = outbox.id, occurred_at, actor, payload})" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="981" as="sourcePoint" /><mxPoint x="700" y="981" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="UPDATE outbox SET published_at = now()" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="1027" as="sourcePoint" /><mxPoint x="280" y="1027" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="UPDATE outbox SET cancelled_at = now()&lt;br&gt;WHERE id = ? AND claimed_at IS NULL&lt;br&gt;AND cancelled_at IS NULL AND published_at IS NULL" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1259" as="sourcePoint" /><mxPoint x="270" y="1259" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="1 row ⇒ never dispatched, safe to abandon · 0 rows ⇒ claimed, do NOT cancel" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1305" as="sourcePoint" /><mxPoint x="65" y="1305" as="targetPoint" /></mxGeometry></mxCell>

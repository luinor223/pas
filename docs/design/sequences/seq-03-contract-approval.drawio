        <mxCell id="m20" value="tx: INSERT workflow_instance (idempotency_key UNIQUE permanent;&lt;br&gt;partial unique WHERE status='IN_PROGRESS')&lt;br&gt;+ ALL workflow_step_instance rows + ALL step_assignee snapshots&lt;br&gt;+ activate step 1 + outbox(instance_started, step_assigned, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="1825" /><mxPoint x="966" y="1849" /></Array><mxPoint x="925" y="1825" as="sourcePoint" /><mxPoint x="925" y="1849" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="OK {instance_id} → relay stamps published_at" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="1885" as="sourcePoint" /><mxPoint x="710" y="1885" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="clear claimed_at, retry_count + 1 → reclaimed after the lease" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="751" y="2041" /><mxPoint x="751" y="2065" /></Array><mxPoint x="710" y="2041" as="sourcePoint" /><mxPoint x="710" y="2065" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="stop retrying, park the outbox row&lt;br&gt;+ outbox('audit.recorded') · document stays SUBMITTED,&lt;br&gt;flagged &quot;workflow initialization failed&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="751" y="2159" /><mxPoint x="751" y="2183" /></Array><mxPoint x="710" y="2159" as="sourcePoint" /><mxPoint x="710" y="2183" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="workflow.instance_started" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="2295" as="sourcePoint" /><mxPoint x="495" y="2295" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m25" value="tx: UPDATE … SET status='UNDER_REVIEW' WHERE status='SUBMITTED'&lt;br&gt;+ status_history (trigger_kind = W) + INSERT processed_event (§9¹)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="2356" /><mxPoint x="536" y="2380" /></Array><mxPoint x="495" y="2356" as="sourcePoint" /><mxPoint x="495" y="2380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m26" value="workflow.instance_started + workflow.step_assigned" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="2515" as="sourcePoint" /><mxPoint x="1560" y="2515" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m27" value="INSERT notification × assignee_ids&lt;br&gt;&quot;New document assigned to you&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1611" y="2576" /><mxPoint x="1611" y="2600" /></Array><mxPoint x="1570" y="2576" as="sourcePoint" /><mxPoint x="1570" y="2600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m28" value="POST /contracts/{id}/cancel" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="2699" as="sourcePoint" /><mxPoint x="485" y="2699" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m29" value="UPDATE outbox SET cancelled_at = now()&lt;br&gt;WHERE id = ? AND claimed_at IS NULL&lt;br&gt;AND cancelled_at IS NULL AND published_at IS NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="2775" /><mxPoint x="536" y="2799" /></Array><mxPoint x="495" y="2775" as="sourcePoint" /><mxPoint x="495" y="2799" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m30" value="WorkflowInternal.CancelInstance(CONTRACT, document_id, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="2873" as="sourcePoint" /><mxPoint x="915" y="2873" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m31" value="OK — instance CANCELLED, remaining steps swept" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="2919" as="sourcePoint" /><mxPoint x="495" y="2919" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m32" value="SUBMITTED → CANCELLED + status_history + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="2965" /><mxPoint x="536" y="2989" /></Array><mxPoint x="495" y="2965" as="sourcePoint" /><mxPoint x="495" y="2989" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m33" value="fresh claim ⇒ back off, retry from the top&lt;br&gt;stale claim ⇒ re-claim the row, run StartInstance with the STORED key,&lt;br&gt;then cancel the instance it creates — never assume it won't complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="3083" /><mxPoint x="536" y="3107" /></Array><mxPoint x="495" y="3083" as="sourcePoint" /><mxPoint x="495" y="3107" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m34" value="cancel refused for the whole document (existing behaviour)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="3171" as="sourcePoint" /><mxPoint x="495" y="3171" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m35" value="POST /workflow-steps/{step_instance_id}/actions&lt;br&gt;{action, comment}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="3274" as="sourcePoint" /><mxPoint x="915" y="3274" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m36" value="assert approval:act ∈ permissions (perm cache)&lt;br&gt;assert caller ∈ step_assignee OF THIS step&lt;br&gt;assert step.status = 'ACTIVE'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="3350" /><mxPoint x="966" y="3374" /></Array><mxPoint x="925" y="3350" as="sourcePoint" /><mxPoint x="925" y="3374" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m37" value="tx: UPDATE workflow_step_instance SET status, version = version + 1&lt;br&gt;WHERE id = ? AND version = ? AND status = 'ACTIVE'&lt;br&gt;+ INSERT workflow_action(comment) (APR-03)&lt;br&gt;+ outbox(step_actioned, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="3503" /><mxPoint x="966" y="3527" /></Array><mxPoint x="925" y="3503" as="sourcePoint" /><mxPoint x="925" y="3527" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m38" value="409 ABORTED — this step was already actioned" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="3611" as="sourcePoint" /><mxPoint x="280" y="3611" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m39" value="activate next step (PENDING → ACTIVE)&lt;br&gt;assignees were already snapshotted at instance creation&lt;br&gt;+ outbox(step_assigned, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="3777" /><mxPoint x="966" y="3801" /></Array><mxPoint x="925" y="3777" as="sourcePoint" /><mxPoint x="925" y="3801" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m40" value="workflow.step_assigned → next step's assignees" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="3837" as="sourcePoint" /><mxPoint x="1560" y="3837" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m41" value="200 {step: APPROVED, next_step: Legal review}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="3883" as="sourcePoint" /><mxPoint x="280" y="3883" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m42" value="instance → APPROVED&lt;br&gt;+ outbox(workflow.completed{APPROVED}, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="3972" /><mxPoint x="966" y="3996" /></Array><mxPoint x="925" y="3972" as="sourcePoint" /><mxPoint x="925" y="3996" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m43" value="workflow.completed {outcome: APPROVED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="4032" as="sourcePoint" /><mxPoint x="495" y="4032" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m44" value="tx: completion guard status IN ('SUBMITTED','UNDER_REVIEW')&lt;br&gt;SUBMITTED: apply SUBMITTED → UNDER_REVIEW first (§9¹)&lt;br&gt;then → APPROVED; one status_history row per edge, both trigger_kind = W&lt;br&gt;+ processed_event (D3) — all in the one transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="4123" /><mxPoint x="536" y="4147" /></Array><mxPoint x="495" y="4123" as="sourcePoint" /><mxPoint x="495" y="4147" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m45" value="workflow.completed → requested_by (&quot;contract approved&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="4183" as="sourcePoint" /><mxPoint x="1560" y="4183" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m46" value="200 {step: APPROVED, document: APPROVED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="4229" as="sourcePoint" /><mxPoint x="280" y="4229" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m47" value="tx: instance → REJECTED | REVISION_REQUESTED&lt;br&gt;sweep remaining PENDING steps → CANCELLED&lt;br&gt;+ outbox(workflow.completed, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="4333" /><mxPoint x="966" y="4357" /></Array><mxPoint x="925" y="4333" as="sourcePoint" /><mxPoint x="925" y="4357" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m48" value="workflow.completed {outcome: REJECTED | REVISION_REQUESTED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="4393" as="sourcePoint" /><mxPoint x="495" y="4393" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m49" value="tx: completion guard status IN ('SUBMITTED','UNDER_REVIEW')&lt;br&gt;SUBMITTED: apply SUBMITTED → UNDER_REVIEW first (§9¹)&lt;br&gt;then → REJECTED | REVISION_REQUESTED; one status_history row per edge,&lt;br&gt;both trigger_kind = W + processed_event — all in the one transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="4484" /><mxPoint x="536" y="4508" /></Array><mxPoint x="495" y="4484" as="sourcePoint" /><mxPoint x="495" y="4508" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m50" value="workflow.completed → requested_by (&quot;rejected — action required&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="4544" as="sourcePoint" /><mxPoint x="1560" y="4544" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m51" value="200 {step: REJECTED, document: REJECTED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="4590" as="sourcePoint" /><mxPoint x="280" y="4590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m52" value="tick" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1775" y="4760" as="sourcePoint" /><mxPoint x="495" y="4760" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m53" value="APPROVED and valid_from ≤ today ⇒ ACTIVE (CTR-05)&lt;br&gt;tx: status + status_history (trigger_kind = S) + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="4821" /><mxPoint x="536" y="4845" /></Array><mxPoint x="495" y="4821" as="sourcePoint" /><mxPoint x="495" y="4845" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m54" value="ACTIVE and valid_to &amp;lt; today ⇒ EXPIRED&lt;br&gt;tx: status + status_history (trigger_kind = S) + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="4896" /><mxPoint x="536" y="4920" /></Array><mxPoint x="495" y="4896" as="sourcePoint" /><mxPoint x="495" y="4920" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m55" value="document.expiring {days_left, owner_user_id} — direct publish, no outbox (D9)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="4956" as="sourcePoint" /><mxPoint x="1345" y="4956" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m56" value="document.expiring → owner_user_id (&quot;contract expiring in 30 days&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="5002" as="sourcePoint" /><mxPoint x="1560" y="5002" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m57" value="tick" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1775" y="5172" as="sourcePoint" /><mxPoint x="925" y="5172" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m58" value="ACTIVE steps where now() − activated_at &amp;gt; sla_hours&lt;br&gt;AND overdue_notified_at IS NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="5233" /><mxPoint x="966" y="5257" /></Array><mxPoint x="925" y="5233" as="sourcePoint" /><mxPoint x="925" y="5257" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m59" value="workflow.step_overdue {waiting_hours, sla_hours, assignee_ids}&lt;br&gt;stamp overdue_notified_at (emit once, not every run)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="5308" as="sourcePoint" /><mxPoint x="1345" y="5308" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m60" value="workflow.step_overdue → assignees (&quot;approval overdue&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="5354" as="sourcePoint" /><mxPoint x="1560" y="5354" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nt0" value="CTR-01: edits and uploads are accepted only in DRAFT or REVISION_REQUESTED — an app-level check against registry §9 plus the version column, since a DB CHECK cannot see a transition." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="395" width="320" height="88" as="geometry" /></mxCell>
        <mxCell id="nt1" value="CTR-02 is a SUBMIT precondition, not a create-time one — the contract stays editable in DRAFT and 4.1 lets its customer be suspended meanwhile, so both facts are re-checked here or a contract for a SUSPENDED customer enters the chain. REVISION_REQUESTED is deliberately NOT admitted: §9 routes it back through DRAFT via 'update' first." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="575" width="320" height="130" as="geometry" /></mxCell>
        <mxCell id="nt2" value="REGISTRY DELTA. It must be a READ: a mutating call before the local commit is exactly the orphan D4 forbids, whereas a read leaves no remote state to orphan if the commit then fails. It exists because db-workflow.md's &quot;zero assignees ⇒ submit fails, nothing strands&quot; is unimplementable once D4 commits SUBMITTED first. The race it cannot close is handled below, not hand-waved." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1130" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt3" value="The guard is what makes a double-clicked Submit a local 409 rather than two status_history rows, two audit rows and two differently-keyed dispatch rows — one of which could never succeed. workflow-service's partial unique index is the second line of defence, not the first." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1448" width="320" height="116" as="geometry" /></mxCell>
        <mxCell id="nt4" value="D4: the document is genuinely SUBMITTED with no instance yet, and the UI says exactly that rather than erroring. Nothing is inconsistent — just briefly incomplete." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1574" width="320" height="74" as="geometry" /></mxCell>
        <mxCell id="nt5" value="Resolution happens before the transaction opens and every row is written inside it, so the existence of an instance implies its completeness. That is what makes §5.1's &quot;a retry with the same key returns the existing instance&quot; safe: otherwise a crash mid-creation leaves a live IN_PROGRESS instance with no steps, and the permanent key makes that state permanent." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1923" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt6" value="Two constraints, two jobs (D4). The permanent key makes retrying THIS dispatch safe at any status, including after cancellation. The partial index rejects a concurrent, differently-keyed double-submit (5.5) while an instance is active. Neither subsumes the other." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2077" width="320" height="102" as="geometry" /></mxCell>
        <mxCell id="nt7" value="The residual race the pre-check cannot close (a sole assignee disabled between check and dispatch) lands here — visibly parked for an admin, never retried forever. Same discipline as seq-07, which terminates a send at FAILED after 3 attempts." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2211" width="320" height="102" as="geometry" /></mxCell>
        <mxCell id="nt8" value="Guarded on the expected from_status and deduped in the same transaction: delivery is at-least-once (D6), so a redelivered instance_started must be a no-op, not a second flip. Order-tolerant in BOTH directions (§9¹): Kafka orders what the relay sent, not what committed, so a workflow.completed can arrive while the document is still SUBMITTED — that handler admits SUBMITTED and applies the skipped SUBMITTED → UNDER_REVIEW edge itself before the outcome, in one transaction, with a status_history row for each edge (both trigger_kind = W). Two §9 edges in sequence, never an edge §9 doesn't have. Conversely an instance_started landing after the outcome matches no row and does nothing. Without both halves a reorder wedges the document permanently. PRICE_LIST and PAYMENT_STATEMENT have no UNDER_REVIEW state and ignore this event entirely." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2408" width="320" height="298" as="geometry" /></mxCell>
        <mxCell id="nt9" value="Relay claim and broker mechanics are exactly seq-02 and are not redrawn." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2716" width="320" height="46" as="geometry" /></mxCell>
        <mxCell id="nt10" value="1 row ⇒ dispatch was never attempted, so no instance can ever exist: set CANCELLED, stop. 0 rows ⇒ the row is claimed — fresh OR stale, treated identically, because a timestamp lease has no fencing and a &quot;stale&quot; worker may merely be paused. The document is NOT flipped yet." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2827" width="320" height="116" as="geometry" /></mxCell>
        <mxCell id="nt11" value="APR-01 in force: role alone is insufficient — only the snapshotted assignees of the ACTIVE step pass. Option A (registry change log): every ACTIVE holder of the step's role IS an assignee — there is no per-manager document ownership, which requirement.md never defines. APR-02 falls out of the same predicate: PENDING steps have no assignees, completed steps are not ACTIVE." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="3402" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt12" value="CTR-04: a REJECTED contract is never auto-resubmitted — REJECTED → DRAFT needs an explicit, audited 'revise' action. REVISION_REQUESTED → DRAFT on update. Either way the next submit generates a NEW idempotency_key and therefore a new instance." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="4628" width="320" height="102" as="geometry" /></mxCell>
        <mxCell id="nt13" value="D14e: contract status never reacts to e-sign. APPROVED → ACTIVE fires on schedule whether a signing session exists, is in flight, or completed — contract-service has no dependency on esign-service at all. 5.5 forbids mixing approval and signing state." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="5040" width="320" height="102" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        <mxCell id="m6" value="assert status = 'DRAFT' (§9 — the only edge into SUBMITTED)&lt;br&gt;assert customer.status = 'ACTIVE'&lt;br&gt;assert valid_from ≤ valid_to&lt;br&gt;assert ≥ 1 attachment          (the last three = CTR-02)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="526" /><mxPoint x="536" y="550" /></Array><mxPoint x="495" y="526" as="sourcePoint" /><mxPoint x="495" y="550" as="targetPoint" /></mxGeometry></mxCell>

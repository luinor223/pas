        <mxCell id="fr2" value="alt [relay dispatch, retried with backoff — D4 step 2]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fontSize=11;fontStyle=2;width=360;height=26;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="1552" width="1850" height="703" as="geometry" /></mxCell>
        <mxCell id="fr2d0" value="[UNAVAILABLE — the only status §5.1 retries in general]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1999" as="sourcePoint" /><mxPoint x="1850" y="1999" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr2d1" value="[FAILED_PRECONDITION / ALREADY_EXISTS — permanent]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="2087" as="sourcePoint" /><mxPoint x="1850" y="2087" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr3" value="alt [Sales cancels while still SUBMITTED — the §M2 handoff]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fontSize=11;fontStyle=2;width=391;height=26;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="2639" width="1850" height="580" as="geometry" /></mxCell>
        <mxCell id="fr3d0" value="[NOT_FOUND — not created YET; §5.1's one retryable NOT_FOUND]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="3011" as="sourcePoint" /><mxPoint x="1850" y="3011" as="targetPoint" /></mxGeometry></mxCell>

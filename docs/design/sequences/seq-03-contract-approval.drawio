        <mxCell id="m12" value="422 — no active LEGAL_REVIEWER; admin must fix role assignments" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="866" as="sourcePoint" /><mxPoint x="65" y="866" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="skip the pre-check, proceed to commit + dispatch&lt;br&gt;(it is an optimisation, never a gate — degrades to plain D4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="940" /><mxPoint x="536" y="964" /></Array><mxPoint x="495" y="940" as="sourcePoint" /><mxPoint x="495" y="964" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="UPDATE contract SET status='SUBMITTED', version = version + 1&lt;br&gt;WHERE id = ? AND status = 'DRAFT' AND version = ?&lt;br&gt;0 rows ⇒ 409, whole tx rolls back (5.5 double submit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="1132" /><mxPoint x="536" y="1156" /></Array><mxPoint x="495" y="1132" as="sourcePoint" /><mxPoint x="495" y="1156" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="+ INSERT status_history (DRAFT→SUBMITTED, trigger_kind = U)&lt;br&gt;+ outbox('workflow.start_requested', payload.idempotency_key)&lt;br&gt;+ outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="1192" /><mxPoint x="536" y="1216" /></Array><mxPoint x="495" y="1192" as="sourcePoint" /><mxPoint x="495" y="1216" as="targetPoint" /></mxGeometry></mxCell>

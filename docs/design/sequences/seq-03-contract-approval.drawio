        <mxCell id="m17" value="WorkflowInternal.StartInstance(CONTRACT, document_id, document_no,&lt;br&gt;customer_name, requested_by, requested_by_name, priority, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="1799" as="sourcePoint" /><mxPoint x="915" y="1799" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="IdentityInternal.ListUsersByRole(role)&lt;br&gt;every distinct role — BEFORE any write" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1845" as="sourcePoint" /><mxPoint x="1130" y="1845" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="ACTIVE users per role" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1891" as="sourcePoint" /><mxPoint x="925" y="1891" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="tx: INSERT workflow_instance (idempotency_key UNIQUE permanent;&lt;br&gt;partial unique WHERE status='IN_PROGRESS')&lt;br&gt;+ ALL workflow_step_instance rows + ALL step_assignee snapshots&lt;br&gt;+ activate step 1 + outbox(instance_started, step_assigned, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="1937" /><mxPoint x="966" y="1961" /></Array><mxPoint x="925" y="1937" as="sourcePoint" /><mxPoint x="925" y="1961" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="OK {instance_id} → relay stamps published_at" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="1997" as="sourcePoint" /><mxPoint x="710" y="1997" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="clear claimed_at, retry_count + 1 → reclaimed after the lease" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="751" y="2343" /><mxPoint x="751" y="2367" /></Array><mxPoint x="710" y="2343" as="sourcePoint" /><mxPoint x="710" y="2367" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="stop retrying, park the outbox row&lt;br&gt;+ outbox('audit.recorded') · document stays SUBMITTED,&lt;br&gt;flagged &quot;workflow initialization failed&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="751" y="2429" /><mxPoint x="751" y="2453" /></Array><mxPoint x="710" y="2429" as="sourcePoint" /><mxPoint x="710" y="2453" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="workflow.instance_started" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="2629" as="sourcePoint" /><mxPoint x="495" y="2629" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m25" value="tx: UPDATE … SET status='UNDER_REVIEW' WHERE status='SUBMITTED'&lt;br&gt;+ status_history (trigger_kind = W) + INSERT processed_event (§9¹)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="2675" /><mxPoint x="536" y="2699" /></Array><mxPoint x="495" y="2675" as="sourcePoint" /><mxPoint x="495" y="2699" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m26" value="workflow.instance_started + workflow.step_assigned" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="2857" as="sourcePoint" /><mxPoint x="1560" y="2857" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m27" value="INSERT notification × assignee_ids&lt;br&gt;&quot;New document assigned to you&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1611" y="2903" /><mxPoint x="1611" y="2927" /></Array><mxPoint x="1570" y="2903" as="sourcePoint" /><mxPoint x="1570" y="2927" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m28" value="POST /contracts/{id}/cancel" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="3055" as="sourcePoint" /><mxPoint x="485" y="3055" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m29" value="UPDATE outbox SET cancelled_at = now()&lt;br&gt;WHERE id = ? AND claimed_at IS NULL&lt;br&gt;AND cancelled_at IS NULL AND published_at IS NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="3101" /><mxPoint x="536" y="3125" /></Array><mxPoint x="495" y="3101" as="sourcePoint" /><mxPoint x="495" y="3125" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m30" value="WorkflowInternal.CancelInstance(CONTRACT, document_id, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="3283" as="sourcePoint" /><mxPoint x="915" y="3283" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m31" value="OK — instance CANCELLED, remaining steps swept" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="3329" as="sourcePoint" /><mxPoint x="495" y="3329" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m32" value="SUBMITTED → CANCELLED + status_history + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="3375" /><mxPoint x="536" y="3399" /></Array><mxPoint x="495" y="3375" as="sourcePoint" /><mxPoint x="495" y="3399" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m33" value="fresh claim ⇒ back off, retry from the top&lt;br&gt;stale claim ⇒ re-claim the row, run StartInstance with the STORED key,&lt;br&gt;then cancel the instance it creates — never assume it won't complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="3461" /><mxPoint x="536" y="3485" /></Array><mxPoint x="495" y="3461" as="sourcePoint" /><mxPoint x="495" y="3485" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m34" value="cancel refused for the whole document (existing behaviour)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="3547" as="sourcePoint" /><mxPoint x="495" y="3547" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m35" value="POST /workflow-steps/{step_instance_id}/actions&lt;br&gt;{action, comment}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="3611" as="sourcePoint" /><mxPoint x="915" y="3611" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m36" value="assert approval:act ∈ permissions (perm cache)&lt;br&gt;assert caller ∈ step_assignee OF THIS step&lt;br&gt;assert step.status = 'ACTIVE'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="3657" /><mxPoint x="966" y="3681" /></Array><mxPoint x="925" y="3657" as="sourcePoint" /><mxPoint x="925" y="3681" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m37" value="tx: UPDATE workflow_step_instance SET status, version = version + 1&lt;br&gt;WHERE id = ? AND version = ? AND status = 'ACTIVE'&lt;br&gt;+ INSERT workflow_action(comment) (APR-03)&lt;br&gt;+ outbox(step_actioned, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="3884" /><mxPoint x="966" y="3908" /></Array><mxPoint x="925" y="3884" as="sourcePoint" /><mxPoint x="925" y="3908" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m38" value="409 ABORTED — this step was already actioned" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="3974" as="sourcePoint" /><mxPoint x="280" y="3974" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m39" value="activate next step (PENDING → ACTIVE)&lt;br&gt;assignees were already snapshotted at instance creation&lt;br&gt;+ outbox(step_assigned, audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="4068" /><mxPoint x="966" y="4092" /></Array><mxPoint x="925" y="4068" as="sourcePoint" /><mxPoint x="925" y="4092" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m40" value="workflow.step_assigned → next step's assignees" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1355" y="4128" as="sourcePoint" /><mxPoint x="1560" y="4128" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m41" value="200 {step: APPROVED, next_step: Legal review}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="4174" as="sourcePoint" /><mxPoint x="280" y="4174" as="targetPoint" /></mxGeometry></mxCell>

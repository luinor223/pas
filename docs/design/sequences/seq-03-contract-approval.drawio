        <mxCell id="m10" value="OK — every step resolves ≥ 1 assignee" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="827" as="sourcePoint" /><mxPoint x="495" y="827" as="targetPoint" /></mxGeometry></mxCell>

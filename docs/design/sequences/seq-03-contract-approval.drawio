        <mxCell id="fr0" value="alt [pre-check — read-only, nothing has committed yet]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fontSize=11;fontStyle=2;width=360;height=26;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="554" width="1850" height="448" as="geometry" /></mxCell>
        <mxCell id="fr0d0" value="[FAILED_PRECONDITION — a step's role has no ACTIVE holder]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="778" as="sourcePoint" /><mxPoint x="1850" y="778" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr0d1" value="[UNAVAILABLE — workflow-service down]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="898" as="sourcePoint" /><mxPoint x="1850" y="898" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr1" value="one local transaction (D4 step 1)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fontSize=11;fontStyle=2;width=230;height=26;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="1078" width="1850" height="176" as="geometry" /></mxCell>
        <mxCell id="fr2" value="alt [relay dispatch, retried with backoff — D4 step 2]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fontSize=11;fontStyle=2;width=360;height=26;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="1390" width="1850" height="592" as="geometry" /></mxCell>
        <mxCell id="fr2d0" value="[UNAVAILABLE — the only status §5.1 retries in general]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1756" as="sourcePoint" /><mxPoint x="1850" y="1756" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr2d1" value="[FAILED_PRECONDITION / ALREADY_EXISTS — permanent]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1844" as="sourcePoint" /><mxPoint x="1850" y="1844" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr3" value="alt [Sales cancels while still SUBMITTED — the §M2 handoff]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fontSize=11;fontStyle=2;width=391;height=26;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="2275" width="1850" height="514" as="geometry" /></mxCell>
        <mxCell id="fr3d0" value="[NOT_FOUND — not created YET; §5.1's one retryable NOT_FOUND]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="2611" as="sourcePoint" /><mxPoint x="1850" y="2611" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr3d1" value="[FAILED_PRECONDITION — a step was already actioned]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="2699" as="sourcePoint" /><mxPoint x="1850" y="2699" as="targetPoint" /></mxGeometry></mxCell>

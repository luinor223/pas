        <mxCell id="fr5d0" value="[APPROVE — final step (APR-05)]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="4208" as="sourcePoint" /><mxPoint x="1850" y="4208" as="targetPoint" /></mxGeometry></mxCell>

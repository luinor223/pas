        <mxCell id="fr0" value="alt [pre-check — read-only, nothing has committed yet]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fontSize=11;fontStyle=2;width=360;height=26;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="614" width="1850" height="484" as="geometry" /></mxCell>
        <mxCell id="fr0d0" value="[FAILED_PRECONDITION — a step's role has no ACTIVE holder]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="859" as="sourcePoint" /><mxPoint x="1850" y="859" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="fr0d1" value="[UNAVAILABLE — workflow-service down]" style="html=1;dashed=1;strokeColor=#9673a6;endArrow=none;align=left;verticalAlign=bottom;spacingLeft=6;fontSize=10;fontStyle=2;fontColor=#6a3d8f;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="979" as="sourcePoint" /><mxPoint x="1850" y="979" as="targetPoint" /></mxGeometry></mxCell>

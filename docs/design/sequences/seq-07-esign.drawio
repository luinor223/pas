        <mxCell id="m5" value="POST /contracts/{id}/send-for-signature&lt;br&gt;{signer_name, signer_email}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="492" as="sourcePoint" /><mxPoint x="915" y="492" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="assert esign:send · assert status = 'APPROVED'&lt;br&gt;tx: NO status change (D14e) + outbox('esign.session_requested')&lt;br&gt;+ outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="538" /><mxPoint x="966" y="562" /></Array><mxPoint x="925" y="538" as="sourcePoint" /><mxPoint x="925" y="562" as="targetPoint" /></mxGeometry></mxCell>

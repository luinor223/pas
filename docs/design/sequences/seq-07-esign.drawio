        <mxCell id="m11" value="BillingInternal.GetSigningPayload(document_id)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1031" as="sourcePoint" /><mxPoint x="495" y="1031" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="{rendered document, statement_no, customer_name, total_amount}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="1077" as="sourcePoint" /><mxPoint x="1130" y="1077" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="POST /sign {document, callback_url = …/callbacks/esign/{session_no}}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1157" as="sourcePoint" /><mxPoint x="1345" y="1157" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="202 {provider_ref}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="1245" as="sourcePoint" /><mxPoint x="1140" y="1245" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="tx: PENDING_SEND → SIGNING, attempts + 1, provider_ref&lt;br&gt;+ status_history + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="1291" /><mxPoint x="1181" y="1315" /></Array><mxPoint x="1140" y="1291" as="sourcePoint" /><mxPoint x="1140" y="1315" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="tx: stay PENDING_SEND, attempts + 1, last_error&lt;br&gt;+ outbox('audit.recorded') · background retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="1379" /><mxPoint x="1181" y="1403" /></Array><mxPoint x="1140" y="1379" as="sourcePoint" /><mxPoint x="1140" y="1403" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="after 3 attempts:&lt;br&gt;tx: PENDING_SEND → FAILED + status_history&lt;br&gt;+ outbox('esign.session_completed'{FAILED}) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="1439" /><mxPoint x="1181" y="1463" /></Array><mxPoint x="1140" y="1439" as="sourcePoint" /><mxPoint x="1140" y="1463" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="POST /callbacks/esign/{session_no} {provider_ref, result}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="1595" as="sourcePoint" /><mxPoint x="1140" y="1595" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="tx: INSERT signing_callback_log (session_no, provider_ref, raw_payload)&lt;br&gt;session_id NULL when neither matches — logged, then ignored" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="1698" /><mxPoint x="1181" y="1722" /></Array><mxPoint x="1140" y="1698" as="sourcePoint" /><mxPoint x="1140" y="1722" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="tx: UPDATE signing_session SET status='SIGNED', version + 1&lt;br&gt;WHERE id = ? AND status IN ('PENDING_SEND','SIGNING') AND version = ?&lt;br&gt;0 rows ⇒ duplicate or post-terminal callback, no-op&lt;br&gt;+ status_history + outbox('esign.session_completed'{SIGNED}) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="1800" /><mxPoint x="1181" y="1824" /></Array><mxPoint x="1140" y="1800" as="sourcePoint" /><mxPoint x="1140" y="1824" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="200" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1884" as="sourcePoint" /><mxPoint x="1345" y="1884" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="esign.session_completed {result: SIGNED, document_no, requested_by, signer_name}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="1930" as="sourcePoint" /><mxPoint x="495" y="1930" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="tx: SIGNING → SIGNED + status_history + processed_event (§9)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="1976" /><mxPoint x="536" y="2000" /></Array><mxPoint x="495" y="1976" as="sourcePoint" /><mxPoint x="495" y="2000" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="esign.session_completed → requested_by (&quot;signature completed&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="2036" as="sourcePoint" /><mxPoint x="1775" y="2036" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m25" value="POST /payment-statements/{id}/publish" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="2082" as="sourcePoint" /><mxPoint x="485" y="2082" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m26" value="SIGNED → ISSUED, issued_at, due_date = issued_at + payment_term&lt;br&gt;+ status_history + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="2128" /><mxPoint x="536" y="2152" /></Array><mxPoint x="495" y="2128" as="sourcePoint" /><mxPoint x="495" y="2152" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m27" value="200 {status: ISSUED, due_date}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="2188" as="sourcePoint" /><mxPoint x="65" y="2188" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m28" value="200" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="2262" as="sourcePoint" /><mxPoint x="1345" y="2262" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m29" value="esign.session_completed {result: FAILED, error}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="2308" as="sourcePoint" /><mxPoint x="495" y="2308" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m30" value="tx: SIGNING → REVISION + status_history + processed_event&lt;br&gt;user is told to fix and resubmit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="2354" /><mxPoint x="536" y="2378" /></Array><mxPoint x="495" y="2354" as="sourcePoint" /><mxPoint x="495" y="2378" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m31" value="esign.session_completed → requested_by (&quot;e-signature failed&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="2414" as="sourcePoint" /><mxPoint x="1775" y="2414" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m32" value="POST /signing-sessions/{id}/cancel {reason}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="2544" as="sourcePoint" /><mxPoint x="1130" y="2544" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m33" value="assert esign:cancel ∈ permissions&lt;br&gt;assert status ∈ {PENDING_SEND, SIGNING}&lt;br&gt;tx: → CANCELLED + status_history&lt;br&gt;+ outbox('esign.session_completed'{CANCELLED}) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="2590" /><mxPoint x="1181" y="2614" /></Array><mxPoint x="1140" y="2590" as="sourcePoint" /><mxPoint x="1140" y="2614" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m34" value="esign.session_completed {result: CANCELLED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="2650" as="sourcePoint" /><mxPoint x="495" y="2650" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m35" value="tx: SIGNING → REVISION + status_history + processed_event (PAY-07)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="2696" /><mxPoint x="536" y="2720" /></Array><mxPoint x="495" y="2696" as="sourcePoint" /><mxPoint x="495" y="2720" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nt0" value="REGISTRY DELTA — reuses D4's dispatch pattern rather than inventing a second one: commit locally, then let the relay retry a gRPC call. Calling esign first and committing after would leave, on a crash, a session that sends to the provider for a statement still APPROVED — a callback for a status §9 has no transition from. One outbox, one pattern, no orphan." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="394" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt1" value="The outbox is still right here even though nothing flips: APR-07 requires the user's send action to survive esign-service being down. The premise differs from billing's (no status to protect) but the conclusion is the same, so contract-service writes the same event_type." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="636" width="320" height="116" as="geometry" /></mxCell>
        <mxCell id="nt2" value="Two constraints, two jobs — the same lesson as workflow_instance (D4). The permanent idempotency_key is what makes a retry safe AFTER the session reached a terminal status: without it, a relay that crashed before stamping published_at would re-dispatch, the status-scoped partial index would no longer apply, and a SECOND session would send to the provider and deliver a second callback for an already-SIGNED document — back to the orphan this delta prevents. The partial index still rejects a genuine concurrent double-send (different key) with FAILED_PRECONDITION, which is permanent, not retryable." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="910" width="320" height="214" as="geometry" /></mxCell>
        <mxCell id="nt3" value="The guard here is status ∈ {APPROVED, SIGNING} for statements (and APPROVED for contract/addendum): billing already moved to SIGNING before dispatching, so a guard of APPROVED-only — as D10 originally worded it — would deadlock every send on an unbounded retry." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1134" width="320" height="102" as="geometry" /></mxCell>
        <mxCell id="nt4" value="APR-07: a provider outage never touches the document's own data. Exhaustion is a terminal FAILED (§9), not an infinite retry — and it carries a status_history row like every other transition, since §9 treats a status change without one as a bug." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1491" width="320" height="102" as="geometry" /></mxCell>
        <mxCell id="nt5" value="Asynchronous gap — minutes to days. The signer acts out of band; nothing in PAS blocks on it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1603" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="nt6" value="D16's single exception: machine-to-machine, but the caller is OUTSIDE the boundary — a real provider is handed a callback URL, not a .proto. The URL carries session_no so the session is identifiable BEFORE provider_ref is persisted: a provider that calls back faster than the 202 handler commits would otherwise be unmatchable, get logged as unknown, and leave the session waiting forever for a callback that already happened (SIGNING has no timeout exit in §9)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1673" width="320" height="172" as="geometry" /></mxCell>
        <mxCell id="nt7" value="PENDING_SEND is accepted, not just SIGNING (db-esign.md) — that is the reordered-webhook case above. The version guard is what makes duplicates and late callbacks no-ops." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1855" width="320" height="74" as="geometry" /></mxCell>
        <mxCell id="nt8" value="CANCELLED is a USER action in §9, never a provider-reported result — drawing it as a callback outcome would attribute the transition to a trigger the table doesn't allow. 4.8 requires &quot;hủy ký&quot; to be a managed state, so it needs its own path with its own permission." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2748" width="320" height="116" as="geometry" /></mxCell>
        <mxCell id="nt9" value="The two state machines never merge (5.5). A statement no longer in SIGNING (ISSUED, REVISION, CANCELLED) that receives a late session_completed is a documented no-op — the guarded UPDATE matches nothing. For a CONTRACT, contract-service does not consume this event at all (D14e): the frontend composes contract status with GET /signing-sessions/by-document/… for display." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2874" width="320" height="144" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        <mxCell id="m1" value="POST /payment-statements/{id}/send-for-signature&lt;br&gt;{signer_name, signer_email}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="205" as="sourcePoint" /><mxPoint x="485" y="205" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="assert esign:send ∈ permissions&lt;br&gt;assert status = 'APPROVED' (PAY-06)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="266" /><mxPoint x="536" y="290" /></Array><mxPoint x="495" y="266" as="sourcePoint" /><mxPoint x="495" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="tx: APPROVED → SIGNING + status_history&lt;br&gt;+ outbox('esign.session_requested', payload.idempotency_key)&lt;br&gt;+ outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="356" /><mxPoint x="536" y="380" /></Array><mxPoint x="495" y="356" as="sourcePoint" /><mxPoint x="495" y="380" as="targetPoint" /></mxGeometry></mxCell>

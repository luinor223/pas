        <mxCell id="m8" value="EsignInternal.CreateSigningSession(document_type, document_id,&lt;br&gt;document_no, signer_name, signer_email, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="766" as="sourcePoint" /><mxPoint x="1130" y="766" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="INSERT signing_session status = 'PENDING_SEND'&lt;br&gt;idempotency_key UNIQUE (permanent, unscoped)&lt;br&gt;+ partial unique (document_type, document_id)&lt;br&gt;  WHERE status IN ('PENDING_SEND','SIGNING')&lt;br&gt;+ status_history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="812" /><mxPoint x="1181" y="836" /></Array><mxPoint x="1140" y="812" as="sourcePoint" /><mxPoint x="1140" y="836" as="targetPoint" /></mxGeometry></mxCell>

  <diagram id="seq-05-volume-period-lock" name="seq-05-volume-period-lock">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2045" pageHeight="2193" math="0" shadow="0">

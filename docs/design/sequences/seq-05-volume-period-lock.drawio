        <mxCell id="m12" value="assert volume:lock_period ∈ permissions&lt;br&gt;assert period.status = 'OPEN' (a second lock is a no-op 409)&lt;br&gt;tx: OPEN → LOCKED, locked_by, locked_by_name, locked_at&lt;br&gt;+ status_history (trigger_kind = U) + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="896" /><mxPoint x="321" y="920" /></Array><mxPoint x="280" y="896" as="sourcePoint" /><mxPoint x="280" y="920" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m7" value="tx: INSERT volume_record (VOL-2026-0712)&lt;br&gt;snapshots: customer_id, customer_name, service_name, unit (D7)&lt;br&gt;+ outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="591" /><mxPoint x="321" y="615" /></Array><mxPoint x="280" y="591" as="sourcePoint" /><mxPoint x="280" y="615" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="201 {record_no, period_state: OPEN}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="651" as="sourcePoint" /><mxPoint x="65" y="651" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="PATCH /volume-records/{id} {quantity}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="697" as="sourcePoint" /><mxPoint x="270" y="697" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="allowed freely while period is OPEN (4.5)&lt;br&gt;tx: UPDATE + outbox(audit.recorded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="743" /><mxPoint x="321" y="767" /></Array><mxPoint x="280" y="743" as="sourcePoint" /><mxPoint x="280" y="767" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="POST /operation-periods/{period_code}/lock" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="803" as="sourcePoint" /><mxPoint x="270" y="803" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="assert volume:lock_period ∈ permissions&lt;br&gt;assert period.status = 'OPEN' (a second lock is a no-op 409)&lt;br&gt;tx: OPEN → LOCKED, locked_by, locked_by_name, locked_at&lt;br&gt;+ status_history (trigger_kind = U) + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="849" /><mxPoint x="321" y="873" /></Array><mxPoint x="280" y="849" as="sourcePoint" /><mxPoint x="280" y="873" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="operations.period_locked {period_code, recipient_role: 'ACCOUNTANT'}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="909" as="sourcePoint" /><mxPoint x="915" y="909" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="operations.period_locked" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1077" as="sourcePoint" /><mxPoint x="1130" y="1077" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="IdentityInternal.ListUsersByRole('ACCOUNTANT')" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1123" as="sourcePoint" /><mxPoint x="1345" y="1123" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="ACTIVE accountants" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="1169" as="sourcePoint" /><mxPoint x="1140" y="1169" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="INSERT notification × N + processed_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1181" y="1215" /><mxPoint x="1181" y="1239" /></Array><mxPoint x="1140" y="1215" as="sourcePoint" /><mxPoint x="1140" y="1239" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="PATCH /volume-records/{id}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1412" as="sourcePoint" /><mxPoint x="270" y="1412" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="403 PERMISSION_DENIED — period LOCKED (4.5)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1458" as="sourcePoint" /><mxPoint x="65" y="1458" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="PATCH /volume-records/{id}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1530" as="sourcePoint" /><mxPoint x="270" y="1530" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="tx: UPDATE volume_record&lt;br&gt;+ outbox('audit.recorded') — MANDATORY on this path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1576" /><mxPoint x="321" y="1600" /></Array><mxPoint x="280" y="1576" as="sourcePoint" /><mxPoint x="280" y="1600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="200 {record_no}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1636" as="sourcePoint" /><mxPoint x="65" y="1636" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="OperationsInternal.ListVolumes(contract_id, period_code)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="1837" as="sourcePoint" /><mxPoint x="280" y="1837" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="{period_state: LOCKED, period_start, period_end,&lt;br&gt;volumes[{record_no, service_code, unit, quantity}]}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1883" as="sourcePoint" /><mxPoint x="1560" y="1883" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nt0" value="Validating and snapshotting in the same call, at entry. Without it an Ops typo in service_code cannot fail until statement time weeks later, where it surfaces as the misleading &quot;no suitable price list&quot; (seq-06). D7 also wants snapshots captured FROM the owner, not client-supplied." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1675" y="446" width="320" height="125" as="geometry" /></mxCell>
        <mxCell id="nt1" value="Published directly, no outbox row — registry §4 marks it informational (&quot;statements can now be generated&quot;). A lost copy costs nothing, unlike the audit.recorded row beside it, which is always outboxed. Two different durability needs in one handler." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1675" y="947" width="320" height="110" as="geometry" /></mxCell>
        <mxCell id="nt2" value="There is no unlock transition (registry §9). The period is the single confirmation signal PAY-02 checks — modelling a per-record confirmed flag as well would be two mechanisms for one fact." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1675" y="1267" width="320" height="95" as="geometry" /></mxCell>
        <mxCell id="nt3" value="4.5's &quot;quyền đặc biệt&quot; escape hatch is only defensible because every use of it is traced. The audit write is not optional here — and because a statement may already be issued off these volumes, the correction downstream is an adjustment statement (PAY-05), never an in-place edit." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1675" y="1674" width="320" height="125" as="geometry" /></mxCell>
        <mxCell id="nt4" value="`period_start`/`period_end` come from the owner's `operation_period` row rather than being re-derived from the period_code string — billing snapshots them onto the statement (PAY-03), so they must be the authoritative values. billing refuses to build unless period_state = LOCKED (PAY-02) — see seq-06." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1675" y="1921" width="320" height="125" as="geometry" /></mxCell>
        <mxCell id="nt5" value="A post-lock edit under the escape hatch changes a quantity a statement may already have snapshotted. For an ISSUED statement the correction is an adjustment (PAY-05); for one still in CALCULATED/RECONCILED, seq-06's reconcile compares snapshot vs current quantity and blocks — otherwise the drift would reach APPROVED undetected." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1675" y="2058" width="320" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

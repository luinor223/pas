        <mxCell id="m1" value="POST /volume-records&lt;br&gt;{period_code, contract_id, service_code, quantity}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="164" as="sourcePoint" /><mxPoint x="270" y="164" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="assert volume:write ∈ permissions&lt;br&gt;assert period.status = 'OPEN'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="210" /><mxPoint x="321" y="234" /></Array><mxPoint x="280" y="210" as="sourcePoint" /><mxPoint x="280" y="234" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="ContractInternal.GetContract(contract_id)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="270" as="sourcePoint" /><mxPoint x="485" y="270" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="{customer_id, customer_name, status} — validates the contract exists" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="316" as="sourcePoint" /><mxPoint x="280" y="316" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m1" value="POST /payment-statements {contract_id, period_code}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="190" as="sourcePoint" /><mxPoint x="270" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="assert no live statement for (contract_id, period_code)&lt;br&gt;partial unique WHERE adjusts_statement_id IS NULL&lt;br&gt;AND status NOT IN ('CANCELLED','REJECTED')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="266" /><mxPoint x="321" y="290" /></Array><mxPoint x="280" y="266" as="sourcePoint" /><mxPoint x="280" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="ContractInternal.GetContract(contract_id)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="326" as="sourcePoint" /><mxPoint x="485" y="326" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="{status, valid_from, valid_to, service_group, vat_rate,&lt;br&gt;payment_term, customer_id, customer_name, contract_no, currency}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="387" as="sourcePoint" /><mxPoint x="280" y="387" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="assert status ∈ {ACTIVE, EXPIRED} — reject DRAFT/SUBMITTED/REJECTED/CANCELLED&lt;br&gt;assert period within [valid_from, valid_to] (PAY-01)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="491" /><mxPoint x="321" y="515" /></Array><mxPoint x="280" y="491" as="sourcePoint" /><mxPoint x="280" y="515" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="OperationsInternal.ListVolumes(contract_id, period_code)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="599" as="sourcePoint" /><mxPoint x="700" y="599" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="{period_state, period_start, period_end, volumes[]}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="645" as="sourcePoint" /><mxPoint x="280" y="645" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="assert period_state = 'LOCKED' (PAY-02)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="691" /><mxPoint x="321" y="715" /></Array><mxPoint x="280" y="691" as="sourcePoint" /><mxPoint x="280" y="715" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="PricingInternal.GetEffectivePriceList(contract_id,&lt;br&gt;customer_id, service_group, date = period_end)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="766" as="sourcePoint" /><mxPoint x="915" y="766" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="{price_list_no, version_no,&lt;br&gt;lines[{service_code, service_name, unit, unit_price, currency}]}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="827" as="sourcePoint" /><mxPoint x="280" y="827" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="assert every volume.service_code is priced in this version&lt;br&gt;else 422 — no suitable price list for the period (PAY-01)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="888" /><mxPoint x="321" y="912" /></Array><mxPoint x="280" y="888" as="sourcePoint" /><mxPoint x="280" y="912" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="INSERT payment_statement&lt;br&gt;snapshots: contract_no, customer_name, period_start/end,&lt;br&gt;price_list_no + version_no, payment_term, vat_rate, currency" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1069" /><mxPoint x="321" y="1093" /></Array><mxPoint x="280" y="1069" as="sourcePoint" /><mxPoint x="280" y="1093" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="INSERT statement_line per priced service_code&lt;br&gt;quantity = Σ of that code's volume records&lt;br&gt;snapshots: service_name, unit, unit_price · source = 'CALCULATED'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1159" /><mxPoint x="321" y="1183" /></Array><mxPoint x="280" y="1159" as="sourcePoint" /><mxPoint x="280" y="1183" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="INSERT statement_line_volume per contributing record&lt;br&gt;(line → volume_record, quantity snapshot)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1234" /><mxPoint x="321" y="1258" /></Array><mxPoint x="280" y="1234" as="sourcePoint" /><mxPoint x="280" y="1258" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="subtotal = Σ amount · tax_amount = subtotal × vat_rate · total_amount&lt;br&gt;DRAFT → CALCULATED + status_history + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1309" /><mxPoint x="321" y="1333" /></Array><mxPoint x="280" y="1309" as="sourcePoint" /><mxPoint x="280" y="1333" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="201 {statement_no: PMT-2026-0331, subtotal, tax_amount, total_amount}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1411" as="sourcePoint" /><mxPoint x="65" y="1411" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="PATCH /payment-statements/{id}/lines&lt;br&gt;{line_no, quantity | unit_price, note}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1568" as="sourcePoint" /><mxPoint x="270" y="1568" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="assert statement:write · assert status ∈ {DRAFT, CALCULATED}&lt;br&gt;(PAY-05: never after APPROVED/SIGNED/ISSUED) · version guard&lt;br&gt;line.source = 'MANUAL' · CALCULATED → DRAFT&lt;br&gt;+ status_history + outbox('audit.recorded')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1659" /><mxPoint x="321" y="1683" /></Array><mxPoint x="280" y="1659" as="sourcePoint" /><mxPoint x="280" y="1683" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="POST /payment-statements/{id}/calculate" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1719" as="sourcePoint" /><mxPoint x="270" y="1719" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="recompute totals · refresh source='CALCULATED' lines,&lt;br&gt;PRESERVE source='MANUAL' lines&lt;br&gt;DRAFT → CALCULATED + status_history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1795" /><mxPoint x="321" y="1819" /></Array><mxPoint x="280" y="1795" as="sourcePoint" /><mxPoint x="280" y="1819" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="POST /payment-statements/{id}/reconcile" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1935" as="sourcePoint" /><mxPoint x="270" y="1935" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="OperationsInternal.ListVolumes(contract_id, period_code)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1981" as="sourcePoint" /><mxPoint x="700" y="1981" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="current volumes" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="2027" as="sourcePoint" /><mxPoint x="280" y="2027" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="re-check: period still LOCKED · contract in force during period ·&lt;br&gt;resolved version still = the snapshotted price_list_no + version_no ·&lt;br&gt;statement_line_volume.quantity == current record quantity ·&lt;br&gt;manual adjustments listed&lt;br&gt;CALCULATED → RECONCILED + status_history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2133" /><mxPoint x="321" y="2157" /></Array><mxPoint x="280" y="2133" as="sourcePoint" /><mxPoint x="280" y="2157" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m25" value="POST /payment-statements/{id}/submit" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="2250" as="sourcePoint" /><mxPoint x="270" y="2250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m26" value="assert ≥ 1 line · total_amount ≥ 0 (PAY-04)&lt;br&gt;assert every LOCKED volume of (contract, period) is mapped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2311" /><mxPoint x="321" y="2335" /></Array><mxPoint x="280" y="2311" as="sourcePoint" /><mxPoint x="280" y="2335" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m27" value="WorkflowInternal.ValidateStartable(PAYMENT_STATEMENT)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="2371" as="sourcePoint" /><mxPoint x="1345" y="2371" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m28" value="OK" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="2417" as="sourcePoint" /><mxPoint x="280" y="2417" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m29" value="tx: RECONCILED → SUBMITTED + status_history&lt;br&gt;+ outbox('workflow.start_requested', idempotency_key) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2478" /><mxPoint x="321" y="2502" /></Array><mxPoint x="280" y="2478" as="sourcePoint" /><mxPoint x="280" y="2502" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m30" value="WorkflowInternal.StartInstance(PAYMENT_STATEMENT, …, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="2586" as="sourcePoint" /><mxPoint x="1345" y="2586" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m31" value="workflow.completed {outcome: APPROVED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="2722" as="sourcePoint" /><mxPoint x="280" y="2722" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m32" value="tx: SUBMITTED → APPROVED + status_history + processed_event&lt;br&gt;→ ready for e-signature (PAY-06, seq-07)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2783" /><mxPoint x="321" y="2807" /></Array><mxPoint x="280" y="2783" as="sourcePoint" /><mxPoint x="280" y="2807" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m33" value="workflow.completed → requested_by (&quot;statement approved&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="2843" as="sourcePoint" /><mxPoint x="1775" y="2843" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m34" value="workflow.completed {outcome: REJECTED | REVISION_REQUESTED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="2917" as="sourcePoint" /><mxPoint x="280" y="2917" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m35" value="tx: SUBMITTED → REJECTED | REVISION + status_history + processed_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2963" /><mxPoint x="321" y="2987" /></Array><mxPoint x="280" y="2963" as="sourcePoint" /><mxPoint x="280" y="2987" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m36" value="workflow.completed → requested_by (&quot;rejected — action required&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="3023" as="sourcePoint" /><mxPoint x="1775" y="3023" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m37" value="POST …/revise → DRAFT (explicit, audited — D14f)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="3069" as="sourcePoint" /><mxPoint x="270" y="3069" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m38" value="POST /payment-statements/{id}/adjustments" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="3205" as="sourcePoint" /><mxPoint x="270" y="3205" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m39" value="assert source status = 'ISSUED'&lt;br&gt;INSERT a NEW statement, adjusts_statement_id = source.id,&lt;br&gt;status = DRAFT — re-enters the build path above&lt;br&gt;the original stays immutable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="3296" /><mxPoint x="321" y="3320" /></Array><mxPoint x="280" y="3296" as="sourcePoint" /><mxPoint x="280" y="3320" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m40" value="201 {statement_no: PMT-2026-0402, adjusts: PMT-2026-0331}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="3356" as="sourcePoint" /><mxPoint x="65" y="3356" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m41" value="POST /payment-statements/{id}/cancel {reason}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="3402" as="sourcePoint" /><mxPoint x="270" y="3402" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m42" value="assert statement:cancel_approved ∈ permissions (in no role bundle, §7)&lt;br&gt;assert status ∈ {APPROVED, SIGNED} · reason mandatory&lt;br&gt;APPROVED|SIGNED → CANCELLED + status_history + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="3478" /><mxPoint x="321" y="3502" /></Array><mxPoint x="280" y="3478" as="sourcePoint" /><mxPoint x="280" y="3502" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nt0" value="Registry §9²: these are the EFFECTIVE values — an approved TERM_EXTENSION or PAYMENT_TERMS addendum has already been applied to the contract row, so billing never has to reason about addenda. That is why 4.3's &quot;nghiệp vụ sau thời điểm hiệu lực dùng thông tin mới&quot; holds here. `service_group` is here because it is the pricing lookup's scope key." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="425" width="320" height="130" as="geometry" /></mxCell>
        <mxCell id="nt1" value="EXPIRED must be admitted, not just ACTIVE. A contract ending 30/06 flips EXPIRED on 01/07 (D14d), and the June statement is always built in July — testing for ACTIVE would make every contract's final period permanently unbillable. PAY-01's real requirement is that the contract was in force *during the period*, which the second assert is what actually checks." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="565" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt2" value="All three reads happen before anything is written, so an UNAVAILABLE callee (§5.1 deadlines) just fails the request with nothing committed — no failure fragment needed. The order is not arbitrary: the contract supplies customer_id + service_group, which are inputs to the pricing lookup, and period_end is the pricing lookup's date." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="940" width="320" height="130" as="geometry" /></mxCell>
        <mxCell id="nt3" value="One line per service, not per volume record — that is what makes `statement_line_volume` a real 1:N trace (the Figma &quot;Source volumes&quot; tab) instead of a 1:1 decoration, and what 4.6's &quot;danh sách dịch vụ, đơn giá, sản lượng tính phí&quot; describes. Nothing here is a live reference: a version published next month or a renamed service must not change what this renders (PAY-03)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1449" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt4" value="The edit drops the status to DRAFT (an edit invalidates the calculation, D14f), so the re-calculate is what makes the loop walkable — reconcile only accepts CALCULATED. Preserving MANUAL lines is the rule that stops the recalculation silently discarding the correction." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1847" width="320" height="116" as="geometry" /></mxCell>
        <mxCell id="nt5" value="Two corrections here. (1) The version check compares against the SNAPSHOT, not &quot;is it still EFFECTIVE&quot; — reconciling a June statement in July finds it SUPERSEDED, which is correct and expected under the historical lookup. (2) The quantity comparison is what catches a post-lock edit made under `volume:edit_locked` (seq-05) after the snapshot was taken; without it stale quantities reach APPROVED, SIGNED and ISSUED undetected — exactly what 4.6's &quot;đối soát&quot; is for." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2185" width="320" height="172" as="geometry" /></mxCell>
        <mxCell id="nt6" value="PAY-05 has two arms and they are different: a wrong *amount* becomes an adjustment statement (the original is never edited), while abandoning the document is the controlled cancel — gated by a permission nobody holds by default and always traced. A negative net correction is cancel-then-reissue, since total_amount ≥ 0 (PAY-04) binds adjustments too." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="3530" width="320" height="130" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

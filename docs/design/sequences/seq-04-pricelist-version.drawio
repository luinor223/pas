        <mxCell id="ab9" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="2403" width="10" height="106" as="geometry" /></mxCell>
        <mxCell id="m1" value="POST /price-lists/{id}/versions&lt;br&gt;{valid_from, valid_to, lines[], addendum_id?}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="190" as="sourcePoint" /><mxPoint x="270" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="assert ≥ 1 scope field set (PRC-01)&lt;br&gt;assert valid_from ≤ valid_to (PRC-02)&lt;br&gt;assert valid_from &amp;gt; the latest LOCKED period's end_date&lt;br&gt;derive scope_key · status = DRAFT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="236" /><mxPoint x="321" y="260" /></Array><mxPoint x="280" y="236" as="sourcePoint" /><mxPoint x="280" y="260" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="POST /price-list-versions/{id}/submit" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="555" as="sourcePoint" /><mxPoint x="270" y="555" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="WorkflowInternal.ValidateStartable(PRICE_LIST)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="601" as="sourcePoint" /><mxPoint x="915" y="601" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="OK" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="647" as="sourcePoint" /><mxPoint x="280" y="647" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="warn on a cross-scope overlap the EXCLUDE cannot see&lt;br&gt;(different scope kinds, same customer — db-pricing.md's residual gap)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="693" /><mxPoint x="321" y="717" /></Array><mxPoint x="280" y="693" as="sourcePoint" /><mxPoint x="280" y="717" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="tx: DRAFT → SUBMITTED + status_history&lt;br&gt;+ outbox('workflow.start_requested', idempotency_key) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="753" /><mxPoint x="321" y="777" /></Array><mxPoint x="280" y="753" as="sourcePoint" /><mxPoint x="280" y="777" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="WorkflowInternal.StartInstance(PRICE_LIST, …, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="843" as="sourcePoint" /><mxPoint x="915" y="843" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="workflow.completed {outcome: APPROVED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="937" as="sourcePoint" /><mxPoint x="280" y="937" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="BEGIN" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1013" as="sourcePoint" /><mxPoint x="485" y="1013" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="assert no overlapping APPROVED/EFFECTIVE version has&lt;br&gt;valid_from ≥ successor.valid_from → else FAILED_PRECONDITION&lt;br&gt;(a successor may not rewrite a later approved version's validity)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1059" as="sourcePoint" /><mxPoint x="485" y="1059" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="UPDATE predecessor SET valid_to = successor.valid_from − 1 day&lt;br&gt;WHERE scope_key = ? AND status IN ('APPROVED','EFFECTIVE')&lt;br&gt;AND id &amp;lt;&amp;gt; :successor_id AND valid_from &amp;lt; :successor_valid_from&lt;br&gt;AND valid_to ≥ :successor_valid_from" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1105" as="sourcePoint" /><mxPoint x="485" y="1105" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="UPDATE successor SET status = 'APPROVED'" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1151" as="sourcePoint" /><mxPoint x="485" y="1151" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="INSERT status_history (successor SUBMITTED→APPROVED, trigger_kind = W)&lt;br&gt;+ INSERT processed_event + INSERT outbox(audit.recorded)&lt;br&gt;the predecessor's valid_to change is an audit 'changes' entry, not a transition" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1197" as="sourcePoint" /><mxPoint x="485" y="1197" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="COMMIT" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1243" as="sourcePoint" /><mxPoint x="485" y="1243" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="ok" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="1289" as="sourcePoint" /><mxPoint x="280" y="1289" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="workflow.completed → requested_by (&quot;price list approved&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1687" as="sourcePoint" /><mxPoint x="1345" y="1687" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="workflow.completed {outcome: REJECTED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1759" as="sourcePoint" /><mxPoint x="280" y="1759" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="tx: SUBMITTED → REJECTED + status_history + processed_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1805" /><mxPoint x="321" y="1829" /></Array><mxPoint x="280" y="1805" as="sourcePoint" /><mxPoint x="280" y="1829" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="workflow.completed → requested_by (&quot;rejected&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1865" as="sourcePoint" /><mxPoint x="1345" y="1865" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="POST …/revise → DRAFT, edit, submit again" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1911" as="sourcePoint" /><mxPoint x="270" y="1911" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="tick" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="2005" as="sourcePoint" /><mxPoint x="280" y="2005" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="APPROVED and valid_from ≤ today ⇒ EFFECTIVE&lt;br&gt;same tx: predecessor EFFECTIVE → SUPERSEDED (PRC-04)&lt;br&gt;supersede is evaluated BEFORE the valid_to → EXPIRED rule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2051" /><mxPoint x="321" y="2075" /></Array><mxPoint x="280" y="2051" as="sourcePoint" /><mxPoint x="280" y="2075" as="targetPoint" /></mxGeometry></mxCell>

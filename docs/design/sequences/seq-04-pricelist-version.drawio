        <mxCell id="m1" value="POST /price-lists/{id}/versions&lt;br&gt;{valid_from, valid_to, lines[], addendum_id?}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="164" as="sourcePoint" /><mxPoint x="270" y="164" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="assert ≥ 1 scope field set (PRC-01)&lt;br&gt;assert valid_from ≤ valid_to (PRC-02)&lt;br&gt;assert valid_from &amp;gt; the latest LOCKED period's end_date&lt;br&gt;derive scope_key · status = DRAFT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="210" /><mxPoint x="321" y="234" /></Array><mxPoint x="280" y="210" as="sourcePoint" /><mxPoint x="280" y="234" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="POST /price-list-versions/{id}/submit" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="529" as="sourcePoint" /><mxPoint x="270" y="529" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="WorkflowInternal.ValidateStartable(PRICE_LIST)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="575" as="sourcePoint" /><mxPoint x="915" y="575" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="OK" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="621" as="sourcePoint" /><mxPoint x="280" y="621" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="warn on a cross-scope overlap the EXCLUDE cannot see&lt;br&gt;(different scope kinds, same customer — db-pricing.md's residual gap)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="667" /><mxPoint x="321" y="691" /></Array><mxPoint x="280" y="667" as="sourcePoint" /><mxPoint x="280" y="691" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="tx: DRAFT → SUBMITTED + status_history&lt;br&gt;+ outbox('workflow.start_requested', idempotency_key) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="727" /><mxPoint x="321" y="751" /></Array><mxPoint x="280" y="727" as="sourcePoint" /><mxPoint x="280" y="751" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="WorkflowInternal.StartInstance(PRICE_LIST, …, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="817" as="sourcePoint" /><mxPoint x="915" y="817" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="workflow.completed {outcome: APPROVED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="911" as="sourcePoint" /><mxPoint x="280" y="911" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="BEGIN" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="987" as="sourcePoint" /><mxPoint x="485" y="987" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="assert no overlapping APPROVED/EFFECTIVE version has&lt;br&gt;valid_from ≥ successor.valid_from → else FAILED_PRECONDITION&lt;br&gt;(a successor may not rewrite a later approved version's validity)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1033" as="sourcePoint" /><mxPoint x="485" y="1033" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="UPDATE predecessor SET valid_to = successor.valid_from − 1 day&lt;br&gt;WHERE scope_key = ? AND status IN ('APPROVED','EFFECTIVE')&lt;br&gt;AND id &amp;lt;&amp;gt; :successor_id AND valid_from &amp;lt; :successor_valid_from&lt;br&gt;AND valid_to ≥ :successor_valid_from" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1079" as="sourcePoint" /><mxPoint x="485" y="1079" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="UPDATE successor SET status = 'APPROVED'" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1125" as="sourcePoint" /><mxPoint x="485" y="1125" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="INSERT status_history (successor SUBMITTED→APPROVED, trigger_kind = W)&lt;br&gt;+ INSERT processed_event + INSERT outbox(audit.recorded)&lt;br&gt;the predecessor's valid_to change is an audit 'changes' entry, not a transition" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1171" as="sourcePoint" /><mxPoint x="485" y="1171" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="COMMIT" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1217" as="sourcePoint" /><mxPoint x="485" y="1217" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="ok" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="1263" as="sourcePoint" /><mxPoint x="280" y="1263" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="workflow.completed → requested_by (&quot;price list approved&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1661" as="sourcePoint" /><mxPoint x="1345" y="1661" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="workflow.completed {outcome: REJECTED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1733" as="sourcePoint" /><mxPoint x="280" y="1733" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="tx: SUBMITTED → REJECTED + status_history + processed_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1779" /><mxPoint x="321" y="1803" /></Array><mxPoint x="280" y="1779" as="sourcePoint" /><mxPoint x="280" y="1803" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="workflow.completed → requested_by (&quot;rejected&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1839" as="sourcePoint" /><mxPoint x="1345" y="1839" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="POST …/revise → DRAFT, edit, submit again" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1885" as="sourcePoint" /><mxPoint x="270" y="1885" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="tick" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="1979" as="sourcePoint" /><mxPoint x="280" y="1979" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="APPROVED and valid_from ≤ today ⇒ EFFECTIVE&lt;br&gt;same tx: predecessor EFFECTIVE → SUPERSEDED (PRC-04)&lt;br&gt;supersede is evaluated BEFORE the valid_to → EXPIRED rule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2025" /><mxPoint x="321" y="2049" /></Array><mxPoint x="280" y="2025" as="sourcePoint" /><mxPoint x="280" y="2049" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="EFFECTIVE and valid_to &amp;lt; today ⇒ EXPIRED (no successor)&lt;br&gt;tx: status + status_history (trigger_kind = S) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2207" /><mxPoint x="321" y="2231" /></Array><mxPoint x="280" y="2207" as="sourcePoint" /><mxPoint x="280" y="2231" as="targetPoint" /></mxGeometry></mxCell>

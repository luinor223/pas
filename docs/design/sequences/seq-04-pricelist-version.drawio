        <mxCell id="ab9" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="2064" width="10" height="106" as="geometry" /></mxCell>
        <mxCell id="m1" value="POST /price-lists/{id}/versions&lt;br&gt;{valid_from, valid_to, lines[], addendum_id?}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="190" as="sourcePoint" /><mxPoint x="270" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="assert ≥ 1 scope field set (PRC-01)&lt;br&gt;assert valid_from ≤ valid_to (PRC-02)&lt;br&gt;assert valid_from &amp;gt; the latest LOCKED period's end_date&lt;br&gt;derive scope_key · status = DRAFT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="236" /><mxPoint x="321" y="260" /></Array><mxPoint x="280" y="236" as="sourcePoint" /><mxPoint x="280" y="260" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="POST /price-list-versions/{id}/submit" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="378" as="sourcePoint" /><mxPoint x="270" y="378" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="WorkflowInternal.ValidateStartable(PRICE_LIST)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="424" as="sourcePoint" /><mxPoint x="915" y="424" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="OK" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="470" as="sourcePoint" /><mxPoint x="280" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="warn on a cross-scope overlap the EXCLUDE cannot see&lt;br&gt;(different scope kinds, same customer — db-pricing.md's residual gap)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="516" /><mxPoint x="321" y="540" /></Array><mxPoint x="280" y="516" as="sourcePoint" /><mxPoint x="280" y="540" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="tx: DRAFT → SUBMITTED + status_history&lt;br&gt;+ outbox('workflow.start_requested', idempotency_key) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="576" /><mxPoint x="321" y="600" /></Array><mxPoint x="280" y="576" as="sourcePoint" /><mxPoint x="280" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="WorkflowInternal.StartInstance(PRICE_LIST, …, idempotency_key)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="678" as="sourcePoint" /><mxPoint x="915" y="678" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="workflow.completed {outcome: APPROVED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="808" as="sourcePoint" /><mxPoint x="280" y="808" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="BEGIN" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="896" as="sourcePoint" /><mxPoint x="485" y="896" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="assert no overlapping APPROVED/EFFECTIVE version has&lt;br&gt;valid_from ≥ successor.valid_from → else FAILED_PRECONDITION&lt;br&gt;(a successor may not rewrite a later approved version's validity)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="942" as="sourcePoint" /><mxPoint x="485" y="942" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="UPDATE predecessor SET valid_to = successor.valid_from − 1 day&lt;br&gt;WHERE scope_key = ? AND status IN ('APPROVED','EFFECTIVE')&lt;br&gt;AND id &amp;lt;&amp;gt; :successor_id AND valid_from &amp;lt; :successor_valid_from&lt;br&gt;AND valid_to ≥ :successor_valid_from" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="988" as="sourcePoint" /><mxPoint x="485" y="988" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="UPDATE successor SET status = 'APPROVED'" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1034" as="sourcePoint" /><mxPoint x="485" y="1034" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="INSERT status_history (successor SUBMITTED→APPROVED, trigger_kind = W)&lt;br&gt;+ INSERT processed_event + INSERT outbox(audit.recorded)&lt;br&gt;the predecessor's valid_to change is an audit 'changes' entry, not a transition" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1080" as="sourcePoint" /><mxPoint x="485" y="1080" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="COMMIT" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1126" as="sourcePoint" /><mxPoint x="485" y="1126" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="ok" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="1172" as="sourcePoint" /><mxPoint x="280" y="1172" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="workflow.completed → requested_by (&quot;price list approved&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1370" as="sourcePoint" /><mxPoint x="1345" y="1370" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="workflow.completed {outcome: REJECTED}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1444" as="sourcePoint" /><mxPoint x="280" y="1444" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="tx: SUBMITTED → REJECTED + status_history + processed_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1490" /><mxPoint x="321" y="1514" /></Array><mxPoint x="280" y="1490" as="sourcePoint" /><mxPoint x="280" y="1514" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="workflow.completed → requested_by (&quot;rejected&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1550" as="sourcePoint" /><mxPoint x="1345" y="1550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="POST …/revise → DRAFT, edit, submit again" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1596" as="sourcePoint" /><mxPoint x="270" y="1596" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="tick" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="1726" as="sourcePoint" /><mxPoint x="280" y="1726" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m23" value="APPROVED and valid_from ≤ today ⇒ EFFECTIVE&lt;br&gt;same tx: predecessor EFFECTIVE → SUPERSEDED (PRC-04)&lt;br&gt;supersede is evaluated BEFORE the valid_to → EXPIRED rule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1772" /><mxPoint x="321" y="1796" /></Array><mxPoint x="280" y="1772" as="sourcePoint" /><mxPoint x="280" y="1796" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m24" value="EFFECTIVE and valid_to &amp;lt; today ⇒ EXPIRED (no successor)&lt;br&gt;tx: status + status_history (trigger_kind = S) + outbox(audit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="1870" /><mxPoint x="321" y="1894" /></Array><mxPoint x="280" y="1870" as="sourcePoint" /><mxPoint x="280" y="1894" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m25" value="document.expiring — price list about to lapse (4.9, D9, direct publish)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1930" as="sourcePoint" /><mxPoint x="1130" y="1930" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m26" value="document.expiring → owner_user_id (&quot;expiring in 14 days&quot;)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;endSize=10;strokeColor=#7B4FA8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1976" as="sourcePoint" /><mxPoint x="1345" y="1976" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m27" value="PricingInternal.GetEffectivePriceList(&lt;br&gt;contract_id, customer_id, service_group, date = period_end)" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1775" y="2064" as="sourcePoint" /><mxPoint x="280" y="2064" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m28" value="resolve scope by precedence:&lt;br&gt;CONTRACT &amp;gt; CUSTOMER+GROUP &amp;gt; CUSTOMER&lt;br&gt;range contains date — SUPERSEDED/EXPIRED included" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="2110" /><mxPoint x="321" y="2134" /></Array><mxPoint x="280" y="2110" as="sourcePoint" /><mxPoint x="280" y="2134" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m29" value="{price_list_no, version_no, status,&lt;br&gt;lines[{service_code, service_name, unit, unit_price, currency}]}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="2170" as="sourcePoint" /><mxPoint x="1775" y="2170" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nt0" value="No backdating: PRC-02 only checks from ≤ to, so without the third assert a successor could be given a valid_from inside an already-billed period, retroactively changing which version was &quot;in force&quot; there — a rebuild or adjustment would then resolve a different version than the original statement snapshotted, defeating the stability PAY-03 exists for." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="288" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt1" value="D8: addendum_id is set only when Sales creates this version from an APPROVED addendum, with valid_from = addendum.effective_from. Manual, no automation, no addendum.* event — pricing stays the single source of unit prices (4.3)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="442" width="320" height="102" as="geometry" /></mxCell>
        <mxCell id="nt2" value="Truncate BEFORE approve, or the EXCLUDE USING gist constraint (scope_key =, daterange &amp;&amp;) WHERE status IN ('APPROVED','EFFECTIVE') rejects the successor and PRC-04's supersede flow becomes unreachable. Truncation never touches unit_price, so PAY-03 snapshots on issued statements are unaffected — and non-overlapping ranges are what make the historical lookup below unambiguous." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1262" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt3" value="The three added predicates matter: `id &lt;&gt; successor` stops the successor truncating ITSELF on a redelivered event (it is APPROVED by then and would otherwise match its own WHERE clause, setting valid_to &lt; valid_from and aborting on PRC-02 forever — a poison message); `valid_from &lt;` scopes truncation to genuine predecessors; and `processed_event` makes this the idempotent consumer every other one already is." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1416" width="320" height="158" as="geometry" /></mxCell>
        <mxCell id="nt4" value="Order pinned deliberately: after truncation the predecessor's valid_to is successor.valid_from − 1, so on activation day both the EXPIRED rule and the SUPERSEDED rule match. §9/PRC-04 permit either, but a version replaced by a successor should read SUPERSEDED, not EXPIRED." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="1824" width="320" height="116" as="geometry" /></mxCell>
        <mxCell id="nt5" value="The response carries service_name and unit because pricing owns the service catalog — billing's PAY-03 line snapshot must come from the authority, not from a snapshot-of-operations'-snapshot. The lookup is historical, not current: a June statement rebuilt in July must resolve the version in force in June. PRC-05 then holds structurally — anything past DRAFT is read-only, so a correction is a new version, never an edit." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="2208" width="320" height="158" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

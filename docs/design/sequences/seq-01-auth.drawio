  <diagram id="seq-01-auth" name="seq-01-auth">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1680" math="0" shadow="0">
      <root>
        <mxCell id="0" />

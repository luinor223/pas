        <mxCell id="ab4" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="766" width="10" height="46" as="geometry" /></mxCell>
        <mxCell id="ab5" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="858" width="10" height="24" as="geometry" /></mxCell>
        <mxCell id="ab6" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1027" width="10" height="46" as="geometry" /></mxCell>
        <mxCell id="ab7" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="915" y="1119" width="10" height="24" as="geometry" /></mxCell>
        <mxCell id="ab8" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="915" y="952" width="10" height="256" as="geometry" /></mxCell>
        <mxCell id="ab9" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="660" width="10" height="594" as="geometry" /></mxCell>
        <mxCell id="ab10" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="485" y="1346" width="10" height="92" as="geometry" /></mxCell>
        <mxCell id="ab11" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="1300" width="10" height="184" as="geometry" /></mxCell>
        <mxCell id="m1" value="SET perm:role:{code} = [permissions]&lt;br&gt;for every role · TTL 6h" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="232" as="sourcePoint" /><mxPoint x="700" y="232" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="POST /auth/login&lt;br&gt;{username, password}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="344" as="sourcePoint" /><mxPoint x="270" y="344" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="POST /auth/login" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="390" as="sourcePoint" /><mxPoint x="485" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="assert app_user.status = 'ACTIVE' (§3)&lt;br&gt;verify password_hash (bcrypt/argon2) · SET last_login_at" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="436" /><mxPoint x="536" y="460" /></Array><mxPoint x="495" y="436" as="sourcePoint" /><mxPoint x="495" y="460" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="200 {access_token}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="544" as="sourcePoint" /><mxPoint x="280" y="544" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="200 {access_token}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="590" as="sourcePoint" /><mxPoint x="65" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="GET /contracts&lt;br&gt;Authorization: Bearer &lt;jwt&gt;" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="660" as="sourcePoint" /><mxPoint x="270" y="660" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="verify signature + exp FIRST&lt;br&gt;(never read a claim out of an unverified token)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="706" /><mxPoint x="321" y="730" /></Array><mxPoint x="280" y="706" as="sourcePoint" /><mxPoint x="280" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="EXISTS blacklist:{jti}" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="766" as="sourcePoint" /><mxPoint x="700" y="766" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="0 — not revoked" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="812" as="sourcePoint" /><mxPoint x="280" y="812" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="coarse role check on the route (D11 layer 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321" y="858" /><mxPoint x="321" y="882" /></Array><mxPoint x="280" y="858" as="sourcePoint" /><mxPoint x="280" y="882" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="GET /contracts&lt;br&gt;+ X-PAS-User-Id / -Username / -Roles / -Department headers" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="952" as="sourcePoint" /><mxPoint x="915" y="952" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="MGET perm:role:{r} for every r ∈ jwt.roles[]" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="1027" as="sourcePoint" /><mxPoint x="710" y="1027" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="[[&quot;contract:read&quot;, …], …]" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="1073" as="sourcePoint" /><mxPoint x="915" y="1073" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="resolved set = UNION over the caller's roles&lt;br&gt;assert contract:read ∈ set (D11 layer 2 — permissions, never roles)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="1119" /><mxPoint x="966" y="1143" /></Array><mxPoint x="925" y="1119" as="sourcePoint" /><mxPoint x="925" y="1143" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="200 [contracts]" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="1208" as="sourcePoint" /><mxPoint x="280" y="1208" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="200 [contracts]" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1254" as="sourcePoint" /><mxPoint x="65" y="1254" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="POST /auth/logout" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="65" y="1300" as="sourcePoint" /><mxPoint x="270" y="1300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="POST /auth/logout" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1346" as="sourcePoint" /><mxPoint x="485" y="1346" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="SETEX blacklist:{jti} … ttl = exp − now" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="1392" as="sourcePoint" /><mxPoint x="700" y="1392" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="204" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="1438" as="sourcePoint" /><mxPoint x="280" y="1438" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="204" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1484" as="sourcePoint" /><mxPoint x="65" y="1484" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nt0" value="§M1: the sweep runs whether or not anything changed. Rewrite-on-change-only would let an idle role's key expire with no trigger left to rewrite it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="270" width="320" height="74" as="geometry" /></mxCell>
        <mxCell id="nt1" value="The status assert is the whole deactivation mechanism: users are never deleted, only flipped to DISABLED (db-identity.md). Without it a disabled account still receives a valid token — the ListUsersByRole ACTIVE filter only stops them being *assigned*, not authenticated. Residual, accepted: a token already issued stays valid until exp; disable does not blacklist the live jti." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="488" width="320" height="144" as="geometry" /></mxCell>
        <mxCell id="nt2" value="JWT claims (registry §6): sub, username, full_name, department, roles[], jti, exp. roles[] only — never permissions[], which would go stale until re-login (D11)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="642" width="320" height="74" as="geometry" /></mxCell>
        <mxCell id="nt3" value="Redis down here fails closed as well: the blacklist cannot be consulted, so the token cannot be shown to be un-revoked. Same policy, same reason, as the permission cache below — Redis is already a hard auth dependency (§M1)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="910" width="320" height="102" as="geometry" /></mxCell>
        <mxCell id="nt4" value="Services trust those headers because the 80xx REST port is reachable only through the gateway (D16) — the gRPC 505x port is not routed at all. Header names are a registry delta." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="1022" width="320" height="88" as="geometry" /></mxCell>
        <mxCell id="nt5" value="Redis unavailable ⇒ PERMISSION_DENIED, fail closed (§M1). Deliberately unlike D9's self-heal: a missed expiry warning costs nothing, a wrongly-granted permission is an incident." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#e0b400;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="1171" width="320" height="88" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        <mxCell id="m8" value="verify signature + exp FIRST&lt;br&gt;(never read a claim out of an unverified token)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;align=left;spacingLeft=8;verticalAlign=middle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="787" /><mxPoint x="536" y="811" /></Array><mxPoint x="495" y="787" as="sourcePoint" /><mxPoint x="495" y="811" as="targetPoint" /></mxGeometry></mxCell>

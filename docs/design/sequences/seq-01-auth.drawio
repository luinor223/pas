        <mxCell id="m1" value="SET perm:role:{code} = [permissions]&lt;br&gt;for every role · TTL 6h" style="html=1;verticalAlign=bottom;align=center;rounded=0;curved=0;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="253" as="sourcePoint" /><mxPoint x="915" y="253" as="targetPoint" /></mxGeometry></mxCell>
